<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="1000"
    android:viewportHeight="1000">

    <!-- 背景：柔和的現代漸層 (保留) -->
    <path
        android:pathData="M0,0 h1000 v1000 h-1000 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="500"
                android:startY="0"
                android:endX="500"
                android:endY="1000"
                android:startColor="#FFFFFF"
                android:endColor="#E9EAF7"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- 底部柔和投影：增加懸浮感與高級感 -->
    <path
        android:fillColor="#1A2D2B55"
        android:pathData="M500,820 m-300,0 a300,100 0 1,0 600,0 a300,100 0 1,0 -600,0" />

    <!-- 簡潔現代的音符設計 (優化：更纖細、優雅) -->
    <group
        android:pivotX="900"
        android:pivotY="600"
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:translateY="-20">

        <!-- 使用漸層藍綠色，線條變細 -->
        <path
            android:pathData="M260,750 C260,794 226,830 180,830 C134,830 100,794 100,750 C100,706 134,670 180,670 C200,670 215,675 230,685 L230,200 L730,100 L730,650 C730,694 696,730 650,730 C604,730 570,694 570,650 C570,606 604,570 650,570 C670,570 685,575 700,585 L700,240 L260,330 L260,750 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="450"
                    android:startY="100"
                    android:endX="450"
                    android:endY="830"
                    android:startColor="#4DD0E1"
                    android:endColor="#00838F"
                    android:type="linear" />
            </aapt:attr>
        </path>

        <!-- 音符頂部的亮面細節 (同步變細) -->
        <path
            android:fillColor="#33FFFFFF"
            android:pathData="M260,330 L730,240 L730,280 L260,370 Z" />
    </group>
</vector>
