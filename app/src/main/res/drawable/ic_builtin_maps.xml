<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="1000"
    android:viewportHeight="1000">

    <!-- 1. 底層背景 (道路與空隙顏色) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M0,0 L1000,0 L1000,1000 L0,1000 Z" />

    <!-- 2. 左上區塊 - 柔和綠 -->
    <path
        android:fillColor="#A5D6A7"
        android:pathData="M0,0 L350,0 L350,380 L0,380 Z" />

    <!-- 3. 左下區塊 - 馬卡龍粉 -->
    <path
        android:fillColor="#F48FB1"
        android:pathData="M0,450 L350,450 L350,1000 L0,1000 Z" />

    <!-- 4. 中央藍色快速道路 -->
    <path
        android:fillColor="#1D9BF0"
        android:pathData="M430,0 L570,0 L570,1000 L430,1000 Z" />

    <!-- 5. 右上區塊 - 嫩綠色 -->
    <path
        android:fillColor="#81C784"
        android:pathData="M650,0 L1000,0 L1000,600 L650,600 Z" />

    <!-- 6. 右下區塊 - 溫暖黃 (向左延伸至 720) -->
    <path
        android:fillColor="#FFF59D"
        android:pathData="M720,650 L1000,650 L1000,1000 L720,1000 Z" />

    <!-- 7. 輔助斜向灰色塊 -->
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M650,300 L1000,650 L1000,750 L650,400 Z" />

    <!-- 8 & 9. 導航指示器組合 (放大 1.5 倍) -->
    <group
        android:pivotX="500"
        android:pivotY="200"
        android:scaleX="1.5"
        android:scaleY="1.5">
        <!-- 8. 中央導航指示器容器 - 藍色圓形 -->
        <path
            android:fillColor="#007AFF"
            android:pathData="M 500, 500 m -125, 0 a 125,125 0 1,0 250,0 a 125,125 0 1,0 -250,0" />

        <!-- 9. 導航箭頭 (白色) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M500,420 L560,560 L500,530 L440,560 Z" />
    </group>

</vector>