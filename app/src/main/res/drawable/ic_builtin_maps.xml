<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- 1. 直角底座 (填滿整個背景) -->
    <path android:pathData="M0,0 h100 v100 h-100 z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="0" android:startY="0" android:endX="100" android:endY="100" android:type="linear">
                <item android:offset="0.0" android:color="#A7F3D0" />
                <item android:offset="1.0" android:color="#34D399" />

            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. 左上綠地公園 (延伸至邊界，直角化) -->
    <path android:pathData="M0,0 h50 v45 h-50 z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="0" android:startY="0" android:endX="50" android:endY="45" android:type="linear">
                <item android:offset="0.0" android:color="#e6ed97" />
                <item android:offset="1.0" android:color="#fbed3b" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. 主幹道路 (延伸至左右邊緣) -->
    <path android:pathData="M0,65 Q35,65 45,45 T100,25 V38 Q55,55 45,75 L0,75 Z" android:fillColor="#FFFFFF" />

    <!-- 4. 水域/河流 (延伸至右下邊界，直角化) -->
    <path android:pathData="M50,100 C70,100 80,75 100,60 V100 H50 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="50" android:startY="60" android:endX="100" android:endY="100" android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="1.0" android:color="#0284C7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5. 立體地標定位標針 (保持比例但位置微調) -->
    <path android:pathData="M48,22 C41.37,22 36,27.37 36,34 C36,44 48,56 48,56 C48,56 60,44 60,34 C60,27.37 54.63,22 48,22 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="36" android:startY="22" android:endX="60" android:endY="56" android:type="linear">
                <item android:offset="0.0" android:color="#FF3E5F" />
                <item android:offset="1.0" android:color="#FEB47B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 6. 地標內圈白點 -->
    <path android:pathData="M48,34m-4,0a4,4 0 1,0 8,0a4,4 0 1,0 -8,0" android:fillColor="#FFFFFF" />

</vector>
