<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="1000"
    android:viewportHeight="1000">

    <!-- 1. 背景：深邃藍色漸層 (滿版) -->
    <path
        android:pathData="M0,0 h1000 v1000 h-1000 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="500"
                android:startY="0"
                android:endX="500"
                android:endY="1000"
                android:type="linear">
                <item android:offset="0" android:color="#2DB9FF"/>
                <item android:offset="1" android:color="#0066FF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. 購物袋主體：梯形磨砂玻璃質感 -->
    <group
        android:translateX="250"
        android:translateY="260">

        <!-- 提手 (優化：更纖細優雅，讓焦點回歸中心) -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="28"
            android:strokeLineCap="round"
            android:pathData="M165,65 c0,-100 170,-100 170,0" />

        <!-- 袋身 (梯形設計：頂窄底寬) -->
        <path
            android:fillColor="#50FFFFFF"
            android:pathData="M100,60 h300 c30,0 45,20 55,50 l40,320 c10,35 -15,65 -50,65 h-390 c-35,0 -60,-30 -50,-65 l40,-320 c10,-30 25,-50 55,-50 z" />

        <!-- 袋子邊緣的高光感 -->
        <path
            android:strokeColor="#40FFFFFF"
            android:strokeWidth="5"
            android:pathData="M100,60 h300 c30,0 45,20 55,50 l40,320 c10,35 -15,65 -50,65 h-390 c-35,0 -60,-30 -50,-65 l40,-320 c10,-30 25,-50 55,-50 z" />

        <!-- 3. 中心標誌：交織層次感的 'A' -->
        <group
            android:translateX="250"
            android:translateY="270">

            <!-- 倒 V 部分 (底層) -->
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="45"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M-110,110 L0,-110 L110,110" />

            <!-- 箭頭主體筆劃 -->
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="45"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M-140,40 C-40,40 60,30 160,-60" />

            <!-- 箭頭尖端 -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M145,-90 L225,-110 L185,-30 Z" />

        </group>
    </group>

</vector>
