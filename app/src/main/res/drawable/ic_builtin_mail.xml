<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 背景 -->
    <path
        android:pathData="M0,0 h1000 v1000 h-1000 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="256"
                android:startY="0"
                android:endX="256"
                android:endY="512"
                android:startColor="#ff7301"
                android:endColor="#ff3f01"
                android:type="linear" />
        </aapt:attr>
    </path>
    <!-- 郵件組：易於調整位置與大小 -->
    <group
        android:pivotX="-26"
        android:pivotY="-6"
        android:scaleX="7"
        android:scaleY="9.2">

        <!-- 信封主體 (白色) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M15,25 h70 a5,5 0 0,1 5,5 v40 a5,5 0 0,1 -5,5 h-70 a5,5 0 0,1 -5,-5 v-40 a5,5 0 0,1 5,-5 z" />

        <!-- 信封摺痕 (淺灰色) -->
        <!-- 上方大 V 摺痕 -->
        <path
            android:strokeColor="#DDD"
            android:strokeWidth="2.4"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M11,30l39,30l39,-30" />

        <!-- 兩側下方的小斜線 -->
        <path
            android:strokeColor="#E0E0E0"
            android:strokeWidth="1.2"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M14,74l22,-20 M86,74l-22,-20" />
    </group>
</vector>