<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <!-- 背景層：灰度漸層 (淺在上，深在下) -->
    <path
        android:pathData="M0,0 h1000 v1000 h-1000 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="256"
                android:startY="0"
                android:endX="256"
                android:endY="512"
                android:startColor="#707070"
                android:endColor="#404040"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- 右上角小紅點 -->
    <path
        android:fillColor="#FF0000"
        android:pathData="M410,102m-18,0a18,18 0,1,1 36,0a18,18 0,1,1 -36,0" />

    <!-- 相機前景層：白色圓框 + 純黑填滿 + 反光點 -->
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <!-- 白色圓圈外框 -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M256,64C150.1,64 64,150.1 64,256s86.1,192 192,192s192,-86.1 192,-192S361.9,64 256,64z" />
        <!-- 純黑色內圓 -->
        <path
            android:fillColor="#000000"
            android:pathData="M256,400c-79.5,0 -144,-64.5 -144,-144s64.5,-144 144,-144s144,64.5 144,144S335.5,400 256,400z" />
        <!-- 鏡頭小白點 (反光效果) -->
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.7"
            android:pathData="M310,202m-16,0a16,16 0,1,1 32,0a16,16 0,1,1 -32,0" />
    </group>
</vector>
