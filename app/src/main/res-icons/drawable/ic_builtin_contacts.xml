<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

  <!-- 1. 筆記本本體 (置於底層) -->
  <path
      android:pathData="M0,0 h1000 v1000 h-1000 z"
      android:fillColor="#d7ccc8"/>

  <!-- 2. 右側標籤層 (下移 16px 使其置中) -->

  <!-- 湛藍 (1/4 處) -->
  <path android:pathData="M420,56 h92 v100 h-92 z">
    <aapt:attr name="android:fillColor">
      <gradient android:startX="420" android:startY="56" android:endX="512" android:endY="156" android:startColor="#00C6FF" android:endColor="#0072FF" android:type="linear" />
    </aapt:attr>
  </path>

  <!-- 紫羅蘭 (2/4 處) -->
  <path android:pathData="M420,156 h92 v100 h-92 z">
    <aapt:attr name="android:fillColor">
      <gradient android:startX="420" android:startY="156" android:endX="512" android:endY="256" android:startColor="#8E2DE2" android:endColor="#4A00E0" android:type="linear" />
    </aapt:attr>
  </path>

  <!-- 活力橘 (3/4 處) -->
  <path android:pathData="M420,256 h92 v100 h-92 z">
    <aapt:attr name="android:fillColor">
      <gradient android:startX="420" android:startY="256" android:endX="512" android:endY="356" android:startColor="#FFB75E" android:endColor="#ED8F03" android:type="linear" />
    </aapt:attr>
  </path>

  <!-- 極光綠 (4/4 處) -->
  <path android:pathData="M420,356 h92 v100 h-92 z">
    <aapt:attr name="android:fillColor">
      <gradient android:startX="420" android:startY="356" android:endX="512" android:endY="456" android:startColor="#42E695" android:endColor="#3BB2B8" android:type="linear" />
    </aapt:attr>
  </path>

  <!-- 3. 中間人物圖標 (無底盤，全新精緻剪影設計) -->
  <group android:pivotX="256" android:pivotY="256" android:scaleX="1.1" android:scaleY="1.1" android:translateX="-28" android:translateY="-4">
      <!-- 頭部 -->
      <path
          android:pathData="M256,170m-52,0a52,52 0,1,1 104,0a52,52 0,1,1 -104,0"
          android:fillColor="#3E2723"/>
      <!-- 肩膀 / 半身剪影 -->
      <path
          android:pathData="M256,246 C190,246 136,290 136,368 C136,378 144,386 154,386 H358 C368,386 376,378 376,368 C376,290 322,246 256,246 Z"
          android:fillColor="#3E2723"/>
  </group>
</vector>
