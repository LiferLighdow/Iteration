<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:height="512dp"
    android:width="512dp"
    android:viewportHeight="512"
    android:viewportWidth="512">

    <!-- White Background -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M0,0 h512 v512 h-512 z" />

    <!-- Folder Group for easy custom scaling and translation adjustment -->
    <group
        android:name="folder_group"
        android:scaleX="0.9"
        android:scaleY="0.9"
        android:pivotX="257"
        android:pivotY="0"
        android:translateX="0"
        android:translateY="10">

        <!-- Back Folder (Tab & Body) -->
        <path
            android:pathData="M64,150 c0,-13.25 10.75,-24 24,-24 h104 l32,28 h200 c13.25,0 24,10.75 24,24 v212 c0,13.25 -10.75,24 -24,24 H88 c-13.25,0 -24,-10.75 -24,-24 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="256"
                    android:startY="126"
                    android:endX="256"
                    android:endY="386"
                    android:startColor="#01bfff"
                    android:endColor="#0070ff"
                    android:type="linear" />
            </aapt:attr>
        </path>

        <!-- White Paper / Document Tab visible prominently at the top slot -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M99,165 h328 c6.63,0 12,5.37 12,12 v16 c0,6.63 -5.37,12 -12,12 H85 c-6.63,0 -12,-5.37 -12,-12 v-16 c0,-6.63 5.37,-12 12,-12 z" />

        <!-- Front Folder Flap (moved down) -->
        <path
            android:pathData="M64,200 c0,-13.25 10.75,-24 24,-24 h336 c13.25,0 24,10.75 24,24 v204 c0,13.25 -10.75,24 -24,24 H88 c-13.25,0 -24,-10.75 -24,-24 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="256"
                    android:startY="176"
                    android:endX="256"
                    android:endY="412"
                    android:startColor="#33ccff"
                    android:endColor="#005ce6"
                    android:type="linear" />
            </aapt:attr>
        </path>

    </group>

</vector>
