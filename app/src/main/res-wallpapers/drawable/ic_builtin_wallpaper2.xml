<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="90dp"
    android:height="180dp"
    android:viewportWidth="90"
    android:viewportHeight="180">

    <!-- Ultimate Synthwave Background -->
    <path android:pathData="M0,0h90v180h-90z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="45" android:startY="0" android:endX="45" android:endY="180" android:type="linear">
                <item android:offset="0" android:color="#0A0A16"/>
                <item android:offset="0.5" android:color="#1A0B2E"/>
                <item android:offset="1" android:color="#0A0A16"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Synthwave Sun (from 5th) -->
    <path android:pathData="M45,60 m-22,0 a22,22 0 1,1 44,0 a22,22 0 1,1 -44,0" android:fillAlpha="0.95">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="45" android:startY="38" android:endX="45" android:endY="82" android:type="linear">
                <item android:offset="0" android:color="#FFE600"/>
                <item android:offset="0.5" android:color="#FF3366"/>
                <item android:offset="1" android:color="#7F00FF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sun Horizontal Band Cuts -->
    <path android:pathData="M23,65h44v1.5h-44z M25,70h40v2h-40z M28,76h34v2.5h-34z" android:fillColor="#0A0A16"/>

    <!-- Floating Monoliths / Towers (from 2nd) -->
    <path android:pathData="M25,60 L45,45 L65,60 L60,95 L30,95 Z" android:fillAlpha="0.3">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="45" android:startY="45" android:endX="45" android:endY="95" android:type="linear">
                <item android:offset="0" android:color="#EC4899"/>
                <item android:offset="1" android:color="#1E1B4B"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Perspective Grid Floor (Combined Cyan & Magenta lines) -->
    <path android:strokeWidth="0.4" android:pathData="M0,100 L90,100 M0,115 L90,115 M0,132 L90,132 M0,155 L90,155" android:strokeColor="#38BDF8" android:fillColor="#00000000" android:strokeAlpha="0.6"/>
    <path android:strokeWidth="0.4" android:pathData="M45,95 L-15,180 M45,95 L15,180 M45,95 L45,180 M45,95 L75,180 M45,95 L105,180" android:strokeColor="#EC4899" android:fillColor="#00000000" android:strokeAlpha="0.5"/>

    <!-- Glowing Horizon Line -->
    <path android:pathData="M0,94h90v3h-90z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="45" android:startY="94" android:endX="45" android:endY="97" android:type="linear">
                <item android:offset="0" android:color="#00EC4899"/>
                <item android:offset="0.5" android:color="#FFEC4899"/>
                <item android:offset="1" android:color="#00EC4899"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
