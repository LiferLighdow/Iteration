                <item android:offset="0.5" android:color="#0F0638"/>
                <item android:offset="1" android:color="#03000C"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Galaxy Core & Nebula -->
    <path android:pathData="M45,90 m-40,0 a40,40 0 1,1 80,0 a40,40 0 1,1 -80,0" android:fillAlpha="0.45">
