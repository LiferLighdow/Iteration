    <!-- Planet Atmospheric Rim Glow -->
    <path android:pathData="M45,90 m-24,0 a24,24 0 1,1 48,0 a24,24 0 1,1 -48,0" android:strokeWidth="0.7" android:strokeColor="#A5F3FC" android:fillColor="#00000000" android:strokeAlpha="0.9"/>

