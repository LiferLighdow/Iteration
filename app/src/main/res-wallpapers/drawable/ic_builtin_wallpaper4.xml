    <!-- Central Ringed Planet Body -->
    <path android:pathData="M45,90 m-24,0 a24,24 0 1,1 48,0 a24,24 0 1,1 -48,0" android:fillAlpha="0.95">
        <aapt:attr name="android:fillColor">
